#include "winres.h"
#include "resource.h"

IDD_QOBUZ_SEARCH DIALOGEX 0, 0, 480, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Qobuz Search"
FONT 12, "Calibri", 500, 0, 0x1
BEGIN
    LTEXT           "Search:", -1, 7, 9, 30, 8
    EDITTEXT        IDC_SEARCH_EDIT, 38, 7, 350, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Search", IDC_SEARCH_BTN, 393, 7, 80, 14, WS_TABSTOP

    CONTROL         "Tracks", IDC_TYPE_TRACKS, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 7, 27, 40, 10
    CONTROL         "Albums", IDC_TYPE_ALBUMS, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 52, 27, 40, 10
    AUTOCHECKBOX    "Hi-Res only", IDC_CHECK_HIRES, 98, 27, 52, 10, WS_TABSTOP

    LTEXT           "", IDC_STATUS_TEXT, 155, 27, 318, 10

    CONTROL         "", IDC_RESULTS_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_VSCROLL,
                    7, 40, 466, 235

    PUSHBUTTON      "Add to Playlist", IDC_ADD_PLAYLIST, 7, 282, 75, 14, WS_TABSTOP
    PUSHBUTTON      "Play Now", IDC_PLAY_NOW, 86, 282, 55, 14, WS_TABSTOP
    PUSHBUTTON      "Album Info...", IDC_ALBUM_INFO, 145, 282, 65, 14, WS_TABSTOP
    PUSHBUTTON      "Close", IDC_CLOSE_BTN, 397, 282, 76, 14, WS_TABSTOP
END

IDD_QOBUZ_ALBUM_INFO DIALOGEX 0, 0, 580, 380
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Album Properties"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ALBUM_INFO_ART, "Static",
                    SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 10, 10, 160, 160
    PUSHBUTTON      "Show Album Art", IDC_ALBUM_INFO_ART_BTN, 10, 175, 75, 14, WS_TABSTOP

    LTEXT           "Title:", IDC_ALBUM_INFO_LBL_TITLE, 180, 10, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_TITLE, 230, 8, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Artist:", IDC_ALBUM_INFO_LBL_ARTIST, 180, 24, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_ARTIST, 230, 22, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Composer:", IDC_ALBUM_INFO_LBL_COMPOSER, 180, 38, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_COMPOSER, 230, 36, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Label:", IDC_ALBUM_INFO_LBL_LABEL, 180, 52, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_LABEL, 230, 50, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Genre:", IDC_ALBUM_INFO_LBL_GENRE, 180, 66, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_GENRE, 230, 64, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Released:", IDC_ALBUM_INFO_LBL_RELEASE_DATE, 180, 80, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_RELEASE_DATE, 230, 78, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "UPC:", IDC_ALBUM_INFO_LBL_UPC, 180, 94, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_UPC, 230, 92, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Specs:", IDC_ALBUM_INFO_LBL_SPECS, 180, 108, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_SPECS, 230, 106, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Volume:", IDC_ALBUM_INFO_LBL_TRACKS_DUR, 180, 122, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_TRACKS_DUR, 230, 120, 310, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Copyright:", IDC_ALBUM_INFO_LBL_COPYRIGHT, 180, 136, 45, 8
    EDITTEXT        IDC_ALBUM_INFO_COPYRIGHT, 230, 134, 310, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "Credits & Performers:", IDC_ALBUM_INFO_LBL_CREDITS, 10, 195, 120, 8
    EDITTEXT        IDC_ALBUM_INFO_CREDITS, 10, 205, 160, 110, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL

    LTEXT           "Description / Review:", IDC_ALBUM_INFO_LBL_DESC, 180, 150, 120, 8
    EDITTEXT        IDC_ALBUM_INFO_DESC, 180, 160, 360, 155, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER

    PUSHBUTTON      "Add to Playlist", IDC_ALBUM_INFO_PLAYLIST_BTN, 10, 320, 85, 14, WS_TABSTOP
    PUSHBUTTON      "Open in Web", IDC_ALBUM_INFO_WEB_BTN, 100, 320, 80, 14, WS_TABSTOP
    PUSHBUTTON      "Close", IDCANCEL, 475, 320, 65, 14, WS_TABSTOP
END

IDD_QOBUZ_TRACK_INFO DIALOGEX 0, 0, 420, 290
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Track Properties"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Title:", -1, 10, 10, 45, 8
    EDITTEXT        IDC_TRACK_INFO_TITLE, 60, 8, 350, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Artist:", -1, 10, 24, 45, 8
    EDITTEXT        IDC_TRACK_INFO_ARTIST, 60, 22, 350, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Composer:", -1, 10, 38, 45, 8
    EDITTEXT        IDC_TRACK_INFO_COMPOSER, 60, 36, 350, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Work:", -1, 10, 52, 45, 8
    EDITTEXT        IDC_TRACK_INFO_WORK, 60, 50, 350, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "Album:", -1, 10, 68, 45, 8
    EDITTEXT        IDC_TRACK_INFO_ALBUM, 60, 66, 350, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Label:", -1, 10, 82, 45, 8
    EDITTEXT        IDC_TRACK_INFO_LABEL, 60, 80, 350, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Genre:", -1, 10, 96, 45, 8
    EDITTEXT        IDC_TRACK_INFO_GENRE, 60, 94, 350, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Released:", -1, 10, 110, 45, 8
    EDITTEXT        IDC_TRACK_INFO_RELEASE_DATE, 60, 108, 140, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "UPC:", -1, 210, 110, 25, 8
    EDITTEXT        IDC_TRACK_INFO_UPC, 240, 108, 170, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "Specs:", -1, 10, 124, 45, 8
    EDITTEXT        IDC_TRACK_INFO_SPECS, 60, 122, 140, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Track/Disc:", -1, 210, 124, 40, 8
    EDITTEXT        IDC_TRACK_INFO_TRACK_DISC, 255, 122, 155, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "ISRC:", -1, 10, 138, 45, 8
    EDITTEXT        IDC_TRACK_INFO_ISRC, 60, 136, 140, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "ReplayGain:", -1, 210, 138, 40, 8
    EDITTEXT        IDC_TRACK_INFO_REPLAYGAIN, 255, 136, 155, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "Copyright:", -1, 10, 152, 45, 8
    EDITTEXT        IDC_TRACK_INFO_COPYRIGHT, 60, 150, 350, 12, ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "Performers & Credits:", -1, 10, 168, 120, 8
    EDITTEXT        IDC_TRACK_INFO_PERFORMERS, 10, 178, 400, 80, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL

    PUSHBUTTON      "Add to Playlist", IDC_TRACK_INFO_PLAYLIST_BTN, 10, 266, 75, 14, WS_TABSTOP
    PUSHBUTTON      "Show Album Art", IDC_TRACK_INFO_ART_BTN, 90, 266, 75, 14, WS_TABSTOP
    PUSHBUTTON      "Open in Web", IDC_TRACK_INFO_WEB_BTN, 170, 266, 70, 14, WS_TABSTOP
    PUSHBUTTON      "Close", IDCANCEL, 355, 266, 55, 14, WS_TABSTOP
END

IDD_QOBUZ_ART_VIEWER DIALOGEX 0, 0, 320, 320
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Album Art"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ART_VIEWER_IMAGE, "Static",
                    SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 0, 0, 320, 320
END

IDD_QOBUZ_PREFS DIALOGEX 0, 0, 320, 150
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_VISIBLE
FONT 10, "Noto Sans CJK JP", 400, 0, 0x1
BEGIN
    LTEXT           "Auth token:", -1, 7, 9, 55, 8
    EDITTEXT        IDC_PREFS_AUTH_EDIT, 65, 7, 248, 14, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP

    LTEXT           "Audio quality:", -1, 7, 29, 55, 8
    CONTROL         "", IDC_PREFS_QUAL_CMB, "ComboBox",
                    CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL, 65, 27, 248, 80

    CONTROL         "Advanced (optional overrides)", -1, "Button",
                    BS_GROUPBOX | WS_GROUP, 7, 50, 306, 58

    LTEXT           "App ID:", -1, 14, 63, 48, 8
    EDITTEXT        IDC_PREFS_APPID_EDT, 65, 61, 241, 14, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Secret:", -1, 14, 81, 48, 8
    EDITTEXT        IDC_PREFS_SECRET_EDT, 65, 79, 241, 14, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "App ID and Secret are auto-fetched. Set these only if auto-fetch fails.",
                    -1, 14, 98, 292, 8

    LTEXT           "Max search results:", -1, 14, 116, 48, 8
    EDITTEXT        IDC_PREFS_LIMIT_EDT, 65, 114, 40, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
END
